---
/**
 * /guides/ — Towing guides index
 */
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/site-header.astro';
import SiteFooter from '../../components/site-footer.astro';
import Breadcrumbs from '../../components/breadcrumbs.astro';

const guides = [
  {
    slug: 'towing-capacity-explained',
    title: 'Towing Capacity Explained',
    desc: 'What towing capacity means, how it is measured, why it varies by configuration, and how to find the correct figure for your vehicle.',
    readTime: '8 min',
    category: 'Fundamentals',
  },
  {
    slug: 'tongue-weight',
    title: 'Understanding Tongue Weight',
    desc: 'Why tongue weight is a separate constraint from towing capacity, how to measure it, and what happens when you exceed the limit.',
    readTime: '6 min',
    category: 'Fundamentals',
  },
  {
    slug: 'payload-capacity',
    title: 'Payload Capacity and Why It Matters',
    desc: 'Payload limits your ability to add passengers and cargo when towing. This guide explains the calculation and how tongue weight reduces your effective payload.',
    readTime: '7 min',
    category: 'Fundamentals',
  },
  {
    slug: 'gcwr',
    title: 'GCWR: Gross Combined Weight Rating',
    desc: 'GCWR is often the controlling constraint when towing near maximum. Learn what it is, how it differs from towing capacity, and how to calculate your combined weight.',
    readTime: '5 min',
    category: 'Fundamentals',
  },
  {
    slug: 'factory-tow-package',
    title: 'Factory Tow Package Requirements',
    desc: 'Why most towing ratings require the factory tow package, what it typically includes, and what you risk by towing without it.',
    readTime: '6 min',
    category: 'Equipment',
  },
  {
    slug: 'hitch-classes',
    title: 'Hitch Classes Explained',
    desc: 'A guide to receiver hitch classes from I through V, their rated capacities, and when each is appropriate for your towing application.',
    readTime: '5 min',
    category: 'Equipment',
  },
];

const categories = [...new Set(guides.map(g => g.category))];
---

<Layout
  title="Towing Guides — Understanding Towing Capacity and Limits"
  description="Guides explaining towing capacity, tongue weight, payload, GCWR, hitch ratings, and factory tow packages. Written for truck, SUV, and trailer owners."
  canonicalUrl="/guides/"
  breadcrumbs={[{ name: 'Guides', url: '/guides/' }]}
>
  <SiteHeader currentPath="/guides/" />

  <main id="main-content">
    <div class="container" style="padding-top: 2rem; padding-bottom: 4rem;">
      <Breadcrumbs crumbs={[{ name: 'Guides' }]} />

      <div class="page-header" style="margin-bottom:2.5rem;">
        <h1 style="font-size:clamp(1.75rem,3vw,2.25rem);margin-bottom:0.625rem;">Towing Guides</h1>
        <p style="color:var(--color-pewter);max-width:54ch;">
          Practical explanations of towing capacity ratings, constraints, and equipment requirements.
        </p>
      </div>

      {categories.map((cat) => (
        <section style="margin-bottom:3rem;" aria-labelledby={`cat-${cat.toLowerCase().replace(' ','')}`}>
          <h2
            id={`cat-${cat.toLowerCase().replace(' ','')}`}
            style="font-size:var(--text-xs);font-weight:500;color:var(--color-electric-blue);letter-spacing:0.1em;text-transform:uppercase;margin-bottom:1rem;"
          >
            {cat}
          </h2>
          <div class="guides-grid">
            {guides.filter(g => g.category === cat).map((guide) => (
              <a href={`/guides/${guide.slug}/`} class="guide-card">
                <div class="guide-card__top">
                  <span class="guide-card__read-time">{guide.readTime} read</span>
                </div>
                <h3 class="guide-card__title">{guide.title}</h3>
                <p class="guide-card__desc">{guide.desc}</p>
                <span class="guide-card__link">
                  Read guide
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </main>

  <SiteFooter />
</Layout>

<style>
  .guides-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
  }

  .guide-card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.5rem;
    background: var(--color-pure-white);
    border: 1px solid var(--color-cloud-gray);
    border-radius: var(--radius-card);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .guide-card:hover {
    border-color: var(--color-electric-blue);
    box-shadow: 0 0 0 1px var(--color-electric-blue);
  }

  .guide-card__top {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .guide-card__read-time {
    font-size: var(--text-xs);
    color: var(--color-silver-fog);
  }

  .guide-card__title {
    font-size: var(--text-md);
    font-weight: 500;
    color: var(--color-carbon-dark);
    line-height: 1.3;
  }

  .guide-card__desc {
    font-size: var(--text-sm);
    color: var(--color-pewter);
    line-height: 1.6;
    flex: 1;
    max-width: none;
  }

  .guide-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-sm);
    color: var(--color-electric-blue);
    font-weight: 500;
    margin-top: auto;
    transition: color var(--transition-fast);
  }

  .guide-card:hover .guide-card__link {
    color: var(--color-electric-blue-dark);
  }
</style>
